{
	auto_https off
	admin off
}

# Local dev mirror of the production Caddy config (scripts/caddyfile.armada).
# Serves the static PWA from web-preview/ and proxies the API + admin UI to the
# local PocketBase instance on 127.0.0.1:8090.
:8080 {
	encode gzip

	# ЕГРЮЛ ФНС proxy for INN lookups from the browser (avoids CORS).
	handle /egrul-api/* {
		uri strip_prefix /egrul-api
		reverse_proxy https://egrul.nalog.ru {
			header_up Host egrul.nalog.ru
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle /_/* {
		reverse_proxy 127.0.0.1:8090
	}
	handle {
		root * {$ARMADA_WEB_ROOT:/workspace/web-preview}
		header Cache-Control "no-store, no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
