# 	handle /cbr-api/* { uri strip_prefix /cbr-api; reverse_proxy https://www.cbr.ru { header_up Host www.cbr.ru } }
# 	handle /egrul-api/* { uri strip_prefix /egrul-api; reverse_proxy https://egrul.nalog.ru { header_up Host egrul.nalog.ru } }
# 	handle { root * /var/www/armada; header Cache-Control "no-store"; try_files {path} /index.html; file_server }
