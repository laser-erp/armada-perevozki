# Шаблон /opt/armada-api/.env на VPS (S3-2.7 Контур).
# Скопировать на сервер, заполнить секреты, НЕ коммитить реальный .env.
#
# После правок: systemctl restart armada-api
# Проверка: curl -sS http://127.0.0.1:8091/health | jq .epd

# --- PocketBase (уже на проде) ---
PB_URL=http://127.0.0.1:8090
# PB_SERVICE_TOKEN=   # или авторизация админа PB
JWT_SECRET=change-me

# --- Оператор ЭПД ---
EPD_OPERATOR=kontur
EPD_SANDBOX=true

# Контур / Diadoc API (Logistics = слой над Diadoc)
# Документация: https://developer.kontur.ru/doc/logistics.api
DIADOC_API_URL=https://diadoc-api.kontur.ru
# DIADOC_API_URL=https://diadoc-api.testkontur.ru   # тестовый контур

# Ключ разработчика (client_id из личного кабинета integrator.kontur.ru)
KONTUR_API_CLIENT_ID=
KONTUR_API_CLIENT_SECRET=

# Ящик организации (boxId) — после Authenticate / GetMyOrganizations
KONTUR_BOX_ID=

# Webhook от оператора (должен совпадать с настройкой в админке → ЭПД)
EPD_WEBHOOK_TOKEN=

# --- Прочее (если используется на сервере) ---
PORT=8091
